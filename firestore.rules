rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userProfile().get("role", "") == "admin";
    }

    // Bill access is intentionally shared: anything saved by Admin in the
    // Bill master-data collections can be read by an enabled Bill user.
    function hasBillAccess() {
      return signedIn()
        && userProfile().get("enabled", true) == true
        && (
          userProfile().get("role", "") == "admin"
          || userProfile().get("role", "") == "bill"
          || userProfile().get("permissions", {}).get("bill", false) == true
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // All reusable data shown in Bill / Tax Invoice dropdowns.
    match /billSellers/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billBuyers/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDescriptions/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDispatchDocs/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDispatchedThrough/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDestinations/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDefaults/{id} {
      allow read, write: if hasBillAccess();
    }

    match /bills/{id} {
      allow read, write: if hasBillAccess();
    }

    // Other application data remains Admin-only.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
