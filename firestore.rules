rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userProfile().role == "admin";
    }

    function hasBillAccess() {
      return signedIn()
        && userProfile().get("enabled", true) == true
        && (
          userProfile().role == "admin"
          || userProfile().role == "bill"
          || userProfile().get("permissions", {}).get("bill", false) == true
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Shared Bill / Tax Invoice master data.
    // Admin-saved data is therefore visible to authorized Bill users.
    match /billSellers/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billBuyers/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDescriptions/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDispatchDocs/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDispatchedThrough/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDestinations/{id} {
      allow read, write: if hasBillAccess();
    }

    match /billDefaults/{id} {
      allow read, write: if hasBillAccess();
    }

    match /bills/{id} {
      allow read, write: if hasBillAccess();
    }

    // Keep unrelated application collections restricted to Admin.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
